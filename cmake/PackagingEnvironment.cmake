include_guard(GLOBAL)

# Pure policy check: tests supply synthetic values; production supplies only
# values read from the build environment. No target-OS override is exposed.
function(kcf_package_environment_error kind id version arch cross processor output)
    set(error "")
    if(cross)
        set(error "Cross compilation is not supported for DEB packaging")
    elseif(NOT id STREQUAL "ubuntu")
        set(error "Unsupported distribution ID='${id}'; Ubuntu is required")
    elseif(NOT version MATCHES "^(24\\.04|26\\.04)$")
        set(error "Unsupported Ubuntu VERSION_ID='${version}'; expected 24.04 or 26.04")
    elseif(NOT arch MATCHES "^(amd64|arm64)$")
        set(error "Unsupported dpkg architecture '${arch}'")
    elseif((arch STREQUAL "amd64" AND NOT processor MATCHES "^(x86_64|amd64|AMD64)$") OR
           (arch STREQUAL "arm64" AND NOT processor MATCHES "^(aarch64|arm64)$"))
        set(error "Target processor '${processor}' disagrees with dpkg architecture '${arch}'")
    elseif(kind STREQUAL "Core")
        if(version STREQUAL "26.04" AND NOT arch STREQUAL "arm64")
            set(error "Unsupported Core combination: Ubuntu ${version} ${arch}")
        endif()
    elseif(kind STREQUAL "Tools")
        if(NOT version STREQUAL "24.04" OR NOT arch STREQUAL "amd64")
            set(error "Unsupported Tools combination: Ubuntu ${version} ${arch}")
        endif()
    else()
        set(error "Unknown package kind '${kind}'")
    endif()
    set(${output} "${error}" PARENT_SCOPE)
endfunction()

# Read data without sourcing shell code. A present primary file always wins;
# malformed/missing fields never fall back to another distribution identity.
function(kcf_read_package_os_release primary fallback out_id out_version out_error)
    set(id "")
    set(version "")
    set(error "")
    if(EXISTS "${primary}")
        set(path "${primary}")
    elseif(EXISTS "${fallback}")
        set(path "${fallback}")
    else()
        set(error "Cannot identify distribution: neither os-release file exists")
    endif()
    if(NOT error)
        file(STRINGS "${path}" lines)
        foreach(line IN LISTS lines)
            if(line MATCHES "^(ID|VERSION_ID)=(.*)$")
                set(key "${CMAKE_MATCH_1}")
                set(value "${CMAKE_MATCH_2}")
                if(value MATCHES "^\"([^\"]*)\"$")
                    set(value "${CMAKE_MATCH_1}")
                elseif(value MATCHES "^'([^']*)'$")
                    set(value "${CMAKE_MATCH_1}")
                endif()
                if(key STREQUAL "ID")
                    set(id "${value}")
                else()
                    set(version "${value}")
                endif()
            endif()
        endforeach()
        if(id STREQUAL "" OR version STREQUAL "")
            set(error "Cannot identify distribution: ID or VERSION_ID missing in ${path}")
        endif()
    endif()
    set(${out_id} "${id}" PARENT_SCOPE)
    set(${out_version} "${version}" PARENT_SCOPE)
    set(${out_error} "${error}" PARENT_SCOPE)
endfunction()

function(kcf_detect_package_environment kind)
    if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Cross compilation is not supported for DEB packaging")
    endif()
    kcf_read_package_os_release("/etc/os-release" "/usr/lib/os-release" id version error)
    if(error)
        message(FATAL_ERROR "${error}")
    endif()
    find_program(KCF_DPKG_EXECUTABLE dpkg)
    if(NOT KCF_DPKG_EXECUTABLE)
        message(FATAL_ERROR "Cannot identify package architecture: dpkg not found")
    endif()
    execute_process(COMMAND "${KCF_DPKG_EXECUTABLE}" --print-architecture
        RESULT_VARIABLE result OUTPUT_VARIABLE arch ERROR_VARIABLE detail
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result STREQUAL "0" OR arch STREQUAL "")
        message(FATAL_ERROR "dpkg --print-architecture failed (${result}): ${detail}")
    endif()
    kcf_package_environment_error("${kind}" "${id}" "${version}" "${arch}"
        "${CMAKE_CROSSCOMPILING}" "${CMAKE_SYSTEM_PROCESSOR}" error)
    if(error)
        message(FATAL_ERROR "${error}")
    endif()
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "DEB packaging requires a native 64-bit compiler ABI")
    endif()
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${arch}" PARENT_SCOPE)
    set(CPACK_DEBIAN_PACKAGE_RELEASE "1+ubuntu${version}" PARENT_SCOPE)
    message(STATUS "${kind} DEB environment: ${id} ${version} ${arch}; revision 1+ubuntu${version}")
endfunction()
