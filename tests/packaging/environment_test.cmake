cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED MODULE)
    get_filename_component(MODULE "${CMAKE_CURRENT_LIST_DIR}/../../cmake/PackagingEnvironment.cmake" ABSOLUTE)
endif()
if(NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Supply -DTEST_DIR=<temporary directory>")
endif()
include("${MODULE}")
set(count 0)
function(check kind id version arch cross processor expected)
    kcf_package_environment_error("${kind}" "${id}" "${version}" "${arch}"
        "${cross}" "${processor}" error)
    if(expected STREQUAL "ALLOW")
        if(error)
            message(FATAL_ERROR "Unexpected rejection: ${error}")
        endif()
    elseif(NOT error MATCHES "${expected}")
        message(FATAL_ERROR "Expected '${expected}', got '${error}'")
    endif()
    math(EXPR next "${count}+1")
    set(count "${next}" PARENT_SCOPE)
endfunction()

check(Core ubuntu 24.04 amd64 FALSE x86_64 ALLOW)
check(Core ubuntu 24.04 arm64 FALSE aarch64 ALLOW)
check(Core ubuntu 26.04 arm64 FALSE aarch64 ALLOW)
check(Tools ubuntu 24.04 amd64 FALSE x86_64 ALLOW)
check(Core ubuntu 26.04 amd64 FALSE x86_64 "Unsupported Core combination")
check(Tools ubuntu 24.04 arm64 FALSE aarch64 "Unsupported Tools combination")
check(Tools ubuntu 26.04 arm64 FALSE aarch64 "Unsupported Tools combination")
check(Tools ubuntu 26.04 amd64 FALSE x86_64 "Unsupported Tools combination")
check(Core debian 24.04 amd64 FALSE x86_64 "Unsupported distribution")
check(Core linuxmint 24.04 amd64 FALSE x86_64 "Unsupported distribution")
check(Core ubuntu 22.04 amd64 FALSE x86_64 "Unsupported Ubuntu")
check(Core ubuntu 28.04 amd64 FALSE x86_64 "Unsupported Ubuntu")
check(Core ubuntu "" amd64 FALSE x86_64 "Unsupported Ubuntu")
check(Core ubuntu 24.04 riscv64 FALSE riscv64 "Unsupported dpkg architecture")
check(Core ubuntu 24.04 armhf FALSE armv7l "Unsupported dpkg architecture")
check(Core ubuntu 24.04 "" FALSE x86_64 "Unsupported dpkg architecture")
check(Core ubuntu 24.04 arm64 TRUE aarch64 "Cross compilation")
check(Tools ubuntu 24.04 amd64 TRUE x86_64 "Cross compilation")
check(Core ubuntu 24.04 arm64 FALSE x86_64 "disagrees")
check(Core ubuntu 24.04 amd64 FALSE aarch64 "disagrees")
check(Core ubuntu 24.04 amd64 FALSE unknown "disagrees")
check(Other ubuntu 24.04 amd64 FALSE x86_64 "Unknown package kind")

file(MAKE_DIRECTORY "${TEST_DIR}")
set(primary "${TEST_DIR}/os-release-primary")
set(fallback "${TEST_DIR}/os-release-fallback")
file(WRITE "${primary}" "ID=ubuntu\nVERSION_ID=\"24.04\"\nID_LIKE=debian\n")
file(WRITE "${fallback}" "ID=ubuntu\nVERSION_ID='26.04'\n")
kcf_read_package_os_release("${primary}" "${fallback}" id version error)
if(error OR NOT id STREQUAL "ubuntu" OR NOT version STREQUAL "24.04")
    message(FATAL_ERROR "Primary/quoted value parsing failed: ${id} ${version} ${error}")
endif()
file(REMOVE "${primary}")
kcf_read_package_os_release("${primary}" "${fallback}" id version error)
if(error OR NOT version STREQUAL "26.04")
    message(FATAL_ERROR "Fallback/single-quoted value parsing failed")
endif()
file(WRITE "${primary}" "ID=ubuntu\n")
kcf_read_package_os_release("${primary}" "${fallback}" id version error)
if(NOT error MATCHES "missing" OR NOT version STREQUAL "")
    message(FATAL_ERROR "Malformed primary must not borrow fallback fields")
endif()
file(REMOVE "${primary}" "${fallback}")
kcf_read_package_os_release("${primary}" "${fallback}" id version error)
if(NOT error MATCHES "neither")
    message(FATAL_ERROR "Absent os-release files must fail")
endif()
message(STATUS "PASS: ${count} synthetic policy cases + 4 os-release parser cases; NOT ARM64 build validation")
